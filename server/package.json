{
  "name": "vouch-server",
  "version": "1.0.0",
  "private": true,
  "description": "Vouch API: validate product ideas with votes, feedback and pre-orders",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "migrate:images": "tsx --env-file=.env scripts/migrate-images-to-r2.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:payments && npm run test:beta",
    "test:payments": "node --env-file=.env.test --import tsx --test --test-concurrency=1 test/api.test.ts",
    "test:beta": "node --env-file=.env.test --env-file=.env.test.beta --import tsx --test --test-concurrency=1 test/beta.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@sentry/node": "^11.11.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
