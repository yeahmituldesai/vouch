NODE_ENV=development
PORT=4000
# false = beta mode: no money moves, people tap "I'd buy this". true = real pre-orders (needs Razorpay).
PAYMENTS_ENABLED=false
DATABASE_URL=postgres://vouch:vouch@127.0.0.1:5432/vouch_dev
# Supabase: paste the Session pooler connection string above and set this to true
DATABASE_SSL=false
# generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-change-me
CORS_ORIGINS=*
# sms: console (prints OTP in the server log) or msg91
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# payments: mock (no money moves) or razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# needed for moderation endpoints (min 16 chars)
ADMIN_TOKEN=
MAX_LIVE_IDEAS=5
# Optional: demo login for Apple App Review (they cannot receive SMS). Both or neither.
REVIEW_PHONE=
REVIEW_CODE=
# Optional: Google sign-in. Set to your Google OAuth client ID to enable.
GOOGLE_CLIENT_ID=
# Optional: error monitoring. Set a Sentry DSN to enable (free tier is enough).
SENTRY_DSN=
# Optional: image uploads via Cloudflare R2 (free tier: 10GB). Leave empty to disable (category icons used).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
SETTLEMENT_INTERVAL_MS=600000
