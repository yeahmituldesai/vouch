{
  "expo": {
    "name": "Vouch",
    "slug": "vouch",
    "version": "beta-v3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vouchapp.vouch",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vouchapp.vouch",
      "versionCode": 18,
      "permissions": ["REQUEST_INSTALL_PACKAGES"],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@sentry/react-native"
    ],
    "scheme": [
      "vouch",
      "com.vouchapp.vouch"
    ],
    "extra": {
      "eas": {
        "projectId": "ec351f0f-2f6d-4ec1-841a-27204e694447"
      }
    },
    "owner": "mitz1"
  }
}
